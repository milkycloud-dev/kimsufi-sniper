# Kimsufi sniper: copy to .env and fill in.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Who may use the bot. Everyone else is ignored without a reply.
# OWNER_ID is your numeric Telegram user id and wins if set.
# Without it, the first /start in a private chat from OWNER_USERNAME pins that user's id for good.
OWNER_ID=
OWNER_USERNAME=

# OVH API keys, needed for reserve and buy modes: https://eu.api.ovh.com/createToken/
# Rights: GET/POST /order/cart, GET/POST/DELETE /order/cart/*, GET /me
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
# ovh-eu with IE/FR/DE..., or ovh-ca with WE/WS (USD) or CA: must match the account the keys belong to
OVH_ENDPOINT=ovh-eu
OVH_SUBSIDIARY=IE

# Preset plans as code:label pairs. Any other plan can be added from the panel catalog.
TARGET_PLANS=25skb012:KS-B,25skc012:KS-C

# Defaults for the first start. After that the panel settings in data/state.json win.
# DEFAULT_MODE: notify, reserve (order without payment) or buy
DEFAULT_MODE=reserve
POLL_INTERVAL=5
# Region: eu, na, apac or all
DEFAULT_REGION=eu
# Price limit excluding tax, in the account currency (EUR for IE/FR/DE, USD for WE/WS)
MAX_PRICE=15.0
PRICE_CURRENCY=EUR
RESERVE_COOLDOWN_HOURS=24

# Buy mode pays with the default payment method. It stays locked unless this is true.
ALLOW_AUTOPAY=false

# Process nice value inside the container (0-19), higher means lower CPU priority
NICE=0

LOG_LEVEL=INFO
